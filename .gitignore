zen_desktop/app/ZenHQChartCompat.js
# 本地 go build 的残留二进制（成品目录 dist/**/release/zen_desktop/ 已另行排除）
zen_desktop/app/zen_desktop
zen_desktop/app/zen_desktop.exe
zen_replay/app/zen_replay
zen_replay/app/zen_replay.exe
zen_replay/zen_replay_debug
# 同步盘/编辑器与混淆流程留下的备份（replay.html.bak 是混淆前的可读件）
*.bak

# 宿主侧验证测试不在公开面留件：测试由内部流程临时拷入、跑完立刻删。
# 这条是兜底 —— 万一跑到一半被 Ctrl-C 或断电，没删干净的半件不会被 push 出去。
# 规范：`applications/` 下不留内部验证材料。
zen_desktop/app/*_verify_test.go
zen_replay/app/*_verify_test.go

# 兜底：常见 npm 临时文件 / 调试日志
npm-debug.log*
npm-debug.log
.yarn-integrity
*.npm.tmp

