# macOS (单独上传 applications 到 GitHub 时也需要排除)
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Secrets - never commit
zen_release.keystore
.env.android
.env.android.bat
# 凭据与机器本地文件（与单仓根 .gitignore 同源）：阶段 1 在 applications 根重新
# git init，单仓根与 zen_plugin/.gitignore 的规则对它不适用，必须在这里自带一份。
# 否则 tdx_dll/zen_license.key、local.properties 这类文件会进公开仓。
*.key
# 本地放置的授权文件，一律不入库
zen_license.txt
zen_license.key.txt
zen_license
local.properties
test_in.json

# Gradle / Android intermediate outputs (regenerable)
build/
.gradle/
.kotlin/
.cxx/

# Android Studio / IntelliJ IDE metadata
.idea/
# Build artifacts that are final packaged outputs (recursively excluded).
# Anything else under dist/<target>/release/ is considered a closed-source
# binary component and SHOULD be tracked.
#
# 已知最终成品目录（按平台）：
#   - zen_desktop/   桌面 app 打包结果（macOS .app、Windows .exe bundle 等）
#   - zen_replay/    回测工具打包结果（macOS/Linux/Windows 可执行）
#   - zen_mobile/    android apk 打包结果
dist/**/release/zen_desktop/
dist/**/release/zen_replay/
dist/**/release/zen_mobile/

# AAR 指纹戳是构建机本地状态（源码哈希 + go/javac 版本 + NDK 版本目录名），
# 不是闭源成品组件，也不是任何人编译所需的输入，不进公开仓。
# 上一行注释里"the stamp lives next to the AAR under dist\ (git-ignored)"
# 说的就是它 —— 规则早先只写在单仓根，公开面这层缺一条，故在此自带一份。
dist/**/*.fingerprint

# 大体积构建产物：HTML 用户手册（从源码生成）
README.html

# 仓库管理脚本（仅本地使用，不应进入开源分发）
reinit_repo.sh

# Desktop app 运行时产物（已生成的旧文件 + npm 依赖树）
zen_desktop/app/manual.html
zen_desktop/app/node_modules/
# Android 构建期同步的 assets（大部分由 Gradle syncZenAssets 注入：闭源组件 + wasm + jscommon + license）
# 同步任务 cleanupZenSyncedAssets 会在 package 阶段只清空它登记过的条目。
# 例外：manual.html 不在同步清单里，是 docs 渲染产物的手工副本，需随手册更新一起 cp 进来。
android/zen_mobile/app/src/main/assets/

# 兜底：常见 npm 临时文件 / 调试日志
npm-debug.log*
npm-debug.log
.yarn-integrity
*.npm.tmp

# AI IDE / assistant context dirs — never upload.
